# Game On Dude! - HTTPS Configuration
# www.gameonguy.com
# Uncomment and configure after you have an SSL certificate in ACM

# To enable HTTPS:
# 1. Request a certificate in AWS Certificate Manager for your domain
# 2. Replace YOUR_CERTIFICATE_ARN with the actual ARN
# 3. Uncomment the settings below

# option_settings:
#   aws:elbv2:listener:443:
#     ListenerEnabled: true
#     Protocol: HTTPS
#     SSLCertificateArns: YOUR_CERTIFICATE_ARN
#     SSLPolicy: ELBSecurityPolicy-TLS13-1-2-2021-06
#     DefaultProcess: default
#
#   # Redirect HTTP to HTTPS
#   aws:elbv2:listener:80:
#     ListenerEnabled: true
#     Protocol: HTTP
#     Rules: redirect-http
#
# Resources:
#   AWSEBV2LoadBalancerListener80Rule:
#     Type: AWS::ElasticLoadBalancingV2::ListenerRule
#     Properties:
#       Actions:
#         - Type: redirect
#           RedirectConfig:
#             Protocol: HTTPS
#             Port: "443"
#             StatusCode: HTTP_301
#       Conditions:
#         - Field: path-pattern
#           Values:
#             - "*"
#       ListenerArn:
#         Ref: AWSEBV2LoadBalancerListener80
#       Priority: 1
