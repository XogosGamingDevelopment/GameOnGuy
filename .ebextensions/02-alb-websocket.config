# Game On Dude! - WebSocket Configuration for ALB
# www.gameonguy.com
# Enables sticky sessions and WebSocket support

option_settings:
  # Use Application Load Balancer (required for WebSocket)
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application

  # Configure the default listener
  aws:elbv2:listener:default:
    ListenerEnabled: true
    Protocol: HTTP

  # Configure the target group for WebSocket
  aws:elasticbeanstalk:environment:process:default:
    DeregistrationDelay: "20"
    HealthCheckInterval: "30"
    HealthCheckTimeout: "5"
    HealthyThresholdCount: "3"
    UnhealthyThresholdCount: "5"
    StickinessEnabled: true
    StickinessLBCookieDuration: "86400"
    StickinessType: lb_cookie

  # Increase connection timeouts for WebSocket
  aws:elbv2:loadbalancer:
    IdleTimeout: "3600"
