# Xogos Multiplayer Server Configuration

# Server
NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
HOST=0.0.0.0

# WebSocket
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xogos_multiplayer
DB_USER=xogos
DB_PASSWORD=your-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Scaling
MAX_ROOMS_PER_SERVER=1000
MAX_PLAYERS_PER_ROOM=100
TICK_RATE_DEFAULT=20
TICK_RATE_FPS=60
TICK_RATE_TURN_BASED=2

# Matchmaking
MATCHMAKING_TIMEOUT=30000
SKILL_MATCH_RANGE=100

# Logging
LOG_LEVEL=debug

# AWS (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
