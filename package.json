{
  "name": "gameondude-server",
  "version": "1.0.0",
  "description": "Game On Dude! - Real-time multiplayer game server platform",
  "main": "dist/index.js",
  "homepage": "https://www.gameonguy.com",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "docker:build": "docker build -t gameondude .",
    "docker:run": "docker run -p 3000:3000 -p 3001:3001 gameondude"
  },
  "keywords": [
    "multiplayer",
    "game-server",
    "websocket",
    "real-time",
    "gameondude",
    "game-on-dude"
  ],
  "author": "Game On Dude!",
  "license": "PROPRIETARY",
  "dependencies": {
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "msgpack-lite": "^0.1.26",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/ws": "^8.5.8",
    "@types/uuid": "^9.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.10.9",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.16",
    "@types/msgpack-lite": "^0.1.10",
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "eslint": "^8.53.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
